# Copy to backend/.env and fill in. The real file is gitignored because it
# holds the signing key and the OAuth secrets.
#
#   cp backend/.env.example backend/.env
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   # JWT_SECRET
#
# Only this section is loaded from the file - the engine calls load_dotenv().
# The client and frontend variables further down are read from the shell.


# =============================================================================
# ENGINE (backend/app, port 8000)
# =============================================================================

# --- Database ---
# The engine's only state is the api_keys and users collections. No documents,
# no vectors, no chat history.
MONGO_URI=mongodb://localhost:27017/
DB_NAME=krish_ai_db

# --- Language model ---
OLLAMA_BASE_URL=http://localhost:11434
MAIN_LLM_MODEL=llama3.2:latest

# --- Answer style ---
# How much of a sentence must trace back to the context before it is kept.
# 0.65 strict and clipped, 0.40 flowing, 0.25 loosest.
GROUNDING_MIN_RATIO=0.4

# --- Dashboard accounts ---
# Signs session tokens. Generate your own; there is no default, and the
# accounts endpoints refuse to work without it. Rotating it signs everyone out.
JWT_SECRET=generate_a_48_byte_url_safe_secret
JWT_EXPIRE_HOURS=72

# --- OAuth sign-in (optional) ---
# Leave a pair blank and that button disappears from the sign-in page rather
# than failing when clicked. Register these callback URLs with each provider:
#   http://localhost:8000/v1/auth/github/callback
#   http://localhost:8000/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where providers send the browser back to. OAUTH_REDIRECT_BASE must be the
# engine's publicly reachable URL; FRONTEND_URL is where the user lands after.
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173


# --- Billing (Stripe) ---
# Leave STRIPE_SECRET_KEY blank and the upgrade button disappears rather than
# failing when clicked. Use the test keys (sk_test_...) until you mean it.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=price_dummy123

# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. The webhook refuses every request without it: it is the only
# thing standing between that endpoint and anyone granting themselves a paid
# plan.
#   stripe listen --forward-to localhost:8000/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=


# =============================================================================
# LOCAL GATEWAY (client_gateway.py and cli.py, port 8001)
# =============================================================================
# Set these in the shell before ./start.sh, not in backend/.env - the gateway
# does not read this file. KRISH_API_KEY also comes from ~/.krish/config.json,
# which the Settings dialog writes with owner-only permissions.

# The engine key, issued from the dashboard. Without it the gateway serves the
# setup screen instead of the app.
KRISH_API_KEY=

KRISH_API_URL=http://localhost:8000
KRISH_GATEWAY_PORT=8001

# Where documents and conversations live on this machine. Never uploaded.
KRISH_HOME=~/.krish

# --- Retrieval ---
# hybrid   keyword and semantic, fused        (default, most accurate)
# lexical  keyword only - no model download
# semantic meaning only
KRISH_RETRIEVAL=hybrid

# Chunks sent to the engine per question, after reranking. Three measured as
# accurate as four (22/24 on a 24-question set) while sending 23% less text.
KRISH_TOP_K=3

# Below this semantic similarity the question is refused locally and the engine
# is never called. Calibrated across three documents: valid questions scored
# 0.12 and up, so this leaves headroom. Raising it starts refusing real
# questions - the valid and off-topic ranges overlap above it.
KRISH_RELEVANCE_FLOOR=0.10

# --- Query expansion ---
# off      no expansion call at all                 (default)
# augment  expansion searches beside the question
# replace  expansion searches instead of it         (measured worse)
#
# Superseded by the cross-encoder below, which reaches the same accuracy by
# reading the candidates instead of guessing the document's wording, for
# ~40ms against ~1.5s. The code path remains if you want to compare.
KRISH_QUERY_EXPANSION=off

# Only a first pass weaker than this pays for expansion. Above it the answer
# was already in the top 4 in every case measured, so the second pass would
# cost ~1.5s to confirm what the first pass found.
KRISH_EXPANSION_TRIGGER=0.30

# Expansion is an optimisation, not a dependency: past this, retrieval runs on
# the question alone rather than making the user wait.
KRISH_EXPANSION_TIMEOUT=3.0

# --- Cross-encoder reranking ---
# Reads each candidate chunk against the question, which retrieval never does.
# Measured on 24 questions: fusion order alone put the right chunk first 19
# times, reranking 22, for ~40ms and a one-time 88MB model download. This is
# what replaced LLM query expansion, which scored the same for ~1.5s.
#
# The legacy RERANKER_ENABLED / RERANKER_MODEL names are also honoured.
KRISH_RERANKER=true
KRISH_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# BAAI/bge-reranker-v2-m3 is the bigger model - 2.2GB on disk against 88MB, a
# multilingual XLM-R large instead of a 6-layer MiniLM - and it was measured
# head to head on the 24-question set rather than assumed better. It lost:
# 19/24 first-place against 21/24, at 195ms per query against 28ms. Both put
# the answer in the top 3 equally often (22/24), so the answers came out the
# same; only the ordering differed. Short policy paragraphs are decided by
# lexical overlap, which is the small model's home ground, and nothing here is
# multilingual. Two further reasons it is not the default: the reranker fails
# open, so a model that cannot be downloaded means no reranking at all and no
# error, and 2.2GB lands on every customer machine. Worth re-measuring on a
# long, multilingual or paraphrase-heavy corpus, where it may well win. Set it
# deliberately, after the download has finished:
#   KRISH_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Candidates scored before narrowing to KRISH_TOP_K.
KRISH_RERANK_POOL=8

# Penalty per place down the fusion list, so neither signal decides alone. An
# unsure cross-encoder cannot bury a chunk retrieval ranked highly. Anything
# from 0.5 to 1.5 measured the same.
KRISH_RERANK_BLEND=0.8


# =============================================================================
# FRONTEND (Vite, port 5173)
# =============================================================================
# Put these in frontend/.env.local if the ports differ from the defaults.
# Both are baked in at build time, so they must be set before "npm run build".
VITE_KRISH_GATEWAY_URL=http://localhost:8001
VITE_KRISH_ENGINE_URL=http://localhost:8000


# =============================================================================
# ./start.sh
# =============================================================================
# Keeps the model in memory between questions but not all day. On an 8GB Mac
# the chat and embedding models together hold ~3.4GB.
OLLAMA_KEEP_ALIVE=5m

# One request at a time. Ollama otherwise reserves several copies of the
# context window, which is waste for a single-user local app.
OLLAMA_NUM_PARALLEL=1

MONGO_DBPATH=~/mongodb-data


# =============================================================================
# NOT CURRENTLY READ
# =============================================================================
# Left from the stateful server. Nothing reads these today - setting them
# changes nothing. The reranker moved to the gateway section above.
#EMBEDDING_MODEL=nomic-embed-text
#DEBUG_LLM_MODEL=qwen2.5-coder:7b
#FALLBACK_LLM_MODEL=mistral:latest
